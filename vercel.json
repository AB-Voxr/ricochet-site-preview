{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "mkdir -p out && cp index.html robots.txt out/ && cp -r img out/img",
  "installCommand": "echo skip",
  "outputDirectory": "out",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "https://ricochetsupplements.com/" },
    { "source": "/:path*", "destination": "https://ricochetsupplements.com/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
